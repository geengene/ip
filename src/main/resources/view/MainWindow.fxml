<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="520.0" prefWidth="680.0" xmlns:fx="http://javafx.com/fxml"
            fx:controller="duke.MainWindow">
    <center>
        <TextArea fx:id="dialogArea" editable="false" wrapText="true" />
    </center>
    <bottom>
        <HBox spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <TextField fx:id="inputField" promptText="Type a command..."
                       HBox.hgrow="ALWAYS" onAction="#handleUserInput" />
            <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
